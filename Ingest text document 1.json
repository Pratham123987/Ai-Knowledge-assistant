{
  "name": "Ingest text document",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst input = raw.body ?? raw;\n\nconst title = (input.title || 'Untitled Document').trim();\nconst fileName = (input.file_name || 'document.txt').trim();\nconst text = String(input.text || '').trim();\n\nif (!text) {\n  throw new Error('body.text is required');\n}\n\nfunction uuidv4() {\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {\n    const r = Math.floor(Math.random() * 16);\n    const v = c === 'x' ? r : (r & 0x3 | 0x8);\n    return v.toString(16);\n  });\n}\n\nconst chunkSize = Number(input.chunk_size || 220);\nconst overlap = Number(input.chunk_overlap || 40);\nconst words = text.split(/\\s+/);\nconst documentId = uuidv4();\n\nconst chunks = [];\nlet start = 0;\nlet index = 0;\n\nwhile (start < words.length) {\n  const end = Math.min(start + chunkSize, words.length);\n  const content = words.slice(start, end).join(' ').trim();\n\n  if (content) {\n    chunks.push({\n      document_id: documentId,\n      chunk_index: index,\n      page_number: 1,\n      content,\n    });\n  }\n\n  if (end >= words.length) break;\n  start = Math.max(0, end - overlap);\n  index += 1;\n}\n\nreturn [{\n  json: {\n    document_id: documentId,\n    title,\n    file_name: fileName,\n    text_length: text.length,\n    chunk_count: chunks.length,\n    chunks,\n    summary: `Indexed ${chunks.length} chunk(s)`\n  }\n}];"
      },
      "id": "b965986f-5d4d-45a9-b580-309f282e49e2",
      "name": "Prepare Document + Chunks",
