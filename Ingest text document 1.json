        "jsCode": "const row = Array.isArray($json) ? $json[0] : $json;\nreturn [{\n  json: {\n    status: 'ready',\n    document_id: row.id || $('Finalize Batch').first().json.document_id,\n    title: row.title,\n    file_name: row.file_name,\n    message: 'Document indexed successfully',\n    chunk_count: row.metadata?.chunk_count || $('Finalize Batch').first().json.chunk_count,\n    summary: row.summary || $('Finalize Batch').first().json.summary\n  }\n}];"
