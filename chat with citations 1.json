        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"model\": \"gemini-2.5-flash\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($('Build Prompt + Sources').first().json.prompt) }}\n    }\n  ],\n  \"temperature\": 0.2\n}",
        "options": {}
      },
      "id": "6620373b-958e-46f1-a931-6f2e87f42858",
      "name": "Generate Answer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2928,
        672
      ]
    },
    {
      "parameters": {
        "jsCode": "const answer = $json.choices?.[0]?.message?.content || 'I could not generate an answer.';\nconst sourcePattern = /\\[([A-Z]\\d+)\\]/g;\nconst sourceMap = new Map($('Build Prompt + Sources').first().json.sources.map(source => [source.source_id, source]));\nconst usedIds = [...new Set(Array.from(answer.matchAll(sourcePattern)).map(match => match[1]))];\nconst citations = usedIds.map(id => sourceMap.get(id)).filter(Boolean);\n\nreturn [{\n  json: {\n    conversation_id: $('Build Prompt + Sources').first().json.conversation_id,\n    answer,\n    citations,\n    sources: $('Build Prompt + Sources').first().json.sources\n  }\n}];"
      },
