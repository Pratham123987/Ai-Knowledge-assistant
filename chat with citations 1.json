    {
      "parameters": {
        "jsCode": "function safeNodeJsons(nodeName) {\n  try {\n    const raw = $items(nodeName, 0, 0) || [];\n    if (!raw.length) return [];\n    if (raw.length === 1 && Array.isArray(raw[0].json)) return raw[0].json;\n    return raw.map(item => item.json);\n  } catch (error) {\n    return [];\n  }\n}\n\nconst sourceRows = safeNodeJsons('Match Chunks');\nconst recentRows = safeNodeJsons('Get Recent Messages');\nconst summaryRows = safeNodeJsons('Get Conversation Summary');\nconst input = $('Normalize Input').first().json;\n\nconst sources = sourceRows.map((row, i) => ({\n  source_id: `S${i + 1}`,\n  chunk_id: row.chunk_id,\n  document_id: row.document_id,\n  document_title: row.document_title,\n  file_name: row.file_name,\n  page_number: row.page_number,\n  quote: row.content,\n  source_type: 'knowledge_base',\n  similarity: row.similarity,\n}));\n\nconst summary = summaryRows[0]?.summary || '';\nconst history = recentRows.length\n  ? [...recentRows].reverse().map(m => `${m.role}: ${m.content}`).join('\\n')\n  : '';\n\nconst sourceBlock = sources.length\n  ? sources.map(s =>\n      `[${s.source_id}] ${s.document_title || s.file_name}${s.page_number ? ` | page ${s.page_number}` : ''}\\n${s.quote}`\n    ).join('\\n\\n')\n  : 'No knowledge base sources were retrieved.';\n\nconst prompt = `You are an AI knowledge assistant.\nAnswer only from the retrieved sources when possible.\nEvery factual statement must cite the exact source id like [S1].\nDo not invent citations.\nIf the answer is not in the sources, say that clearly.\n\nConversation summary:\n${summary || 'None'}\n\nRecent conversation:\n${history || 'None'}\n\nRetrieved sources:\n${sourceBlock}\n\nUser question:\n${input.message}`;\n\nreturn [{\n  json: {\n    conversation_id: input.conversation_id,\n    user_message: input.message,\n    prompt,\n    sources,\n  }\n}];"
      },
