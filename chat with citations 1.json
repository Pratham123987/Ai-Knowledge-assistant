    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst input = raw.body ?? raw;\n\nconst message = String(input.message || '').trim();\n\nif (!message) {\n  throw new Error('body.message is required');\n}\n\nfunction uuidv4() {\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {\n    const r = Math.floor(Math.random() * 16);\n    const v = c === 'x' ? r : (r & 0x3 | 0x8);\n    return v.toString(16);\n  });\n}\n\nconst conversationId = input.conversation_id || uuidv4();\nconst documentIds = Array.isArray(input.document_ids)\n  ? input.document_ids.filter(Boolean)\n  : [];\n\nreturn [{\n  json: {\n    conversation_id: conversationId,\n    is_new_conversation: !input.conversation_id,\n    title: message.slice(0, 80),\n    message,\n    document_ids: documentIds,\n    top_k: Number(input.top_k || 6)\n  }\n}];"
      },
