        "body": "={\n  \"query_embedding\": \"{{ JSON.stringify($json.embedding.values) }}\",\n  \"match_count\": {{$('Normalize Input').first().json.top_k}},\n  \"filter_document_ids\": {{$('Normalize Input').first().json.document_ids.length ? JSON.stringify($('Normalize Input').first().json.document_ids) : 'null'}}\n}",
        "options": {}
